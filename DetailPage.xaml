<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GestionLibrosApp.DetailPage"
             Title="Detalle del Libro">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label x:Name="TituloLabel" FontSize="24" FontAttributes="Bold" TextColor="DarkBlue"/>
        <Label x:Name="AutorLabel" FontSize="16" FontAttributes="Italic" TextColor="Gray"/>
        <Label x:Name="CategoriaLabel" FontSize="14" TextColor="DarkSlateGray"/>
        <BoxView HeightRequest="1" Color="LightGray" Margin="0,10"/>
        <Label Text="Sinopsis:" FontAttributes="Bold" FontSize="16"/>
        <Label x:Name="SinopsisLabel" FontSize="15" TextColor="Black"/>
    </VerticalStackLayout>

</ContentPage>